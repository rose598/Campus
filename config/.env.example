# GraphCampus 环境变量配置
# 复制本文件为 .env 并填入真实值后启动

# LLM API 配置
LLM_API_KEY=sk-your-key-here

# LLM 服务地址（可选；使用 OpenAI 官方时可留空）
# LLM_BASE_URL=https://api.openai.com/v1

# Embedding 模型（可选；默认使用 config.yaml 中的值）
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 数据库路径（可选；默认使用 config.yaml 中的值）
# DB_PATH=data/graphcampus.db